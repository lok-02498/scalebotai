# ScaleBotAI environment - copy to .env and change every "change-me" value.
#   cp .env.example .env
# docker-compose.yml loads this file; Kubernetes uses k8s/base/01-configmap.yaml
# (non-secret values) and k8s/base/02-secret.yaml (secrets) instead.

# --- Application ------------------------------------------------------------
APP_NAME=ScaleBotAI
APP_ENV=production
APP_VERSION=1.0.0
LOG_LEVEL=INFO
LOG_FORMAT=json
# Empty = stdout only. docker-compose sets /var/log/scalebotai/app.log for Logstash.
LOG_FILE=
CORS_ORIGINS=*

# --- Chatbot: rule (Option 1, default) | llm (Option 2: Ollama + TinyLlama) --
CHATBOT_MODE=rule
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=tinyllama
OLLAMA_TIMEOUT_SECONDS=20

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=scalebotai
POSTGRES_USER=scalebot
POSTGRES_PASSWORD=change-me-postgres-password
# Read-only role used by postgres-exporter (created by docker/postgres/init/01-init.sql)
POSTGRES_MONITORING_PASSWORD=change-me-monitoring-password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10
AUTO_CREATE_TABLES=true
# Optional full override: DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db

# --- Redis -----------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me-redis-password
CACHE_TTL_SECONDS=3600
# Optional full override: REDIS_URL=redis://:pass@host:6379/0

# --- Security --------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-use-a-long-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
RATE_LIMIT_ENABLED=true
# Raise (e.g. 100000) or disable while load testing from few source IPs.
RATE_LIMIT_PER_MINUTE=120

# --- Bootstrap admin (created on first start when ADMIN_PASSWORD is set) ----------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@scalebotai.local
ADMIN_PASSWORD=change-me-Admin123

# --- Monitoring --------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# --- Image / CI ----------------------------------------------------------------------
DOCKERHUB_USER=scalebotai
IMAGE_TAG=local
