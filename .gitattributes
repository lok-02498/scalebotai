# Normalize line endings; files that run inside Linux containers must stay LF
# even on Windows checkouts (CRLF breaks bash shebangs and nginx entrypoints).
* text=auto
*.sh        text eol=lf
Jenkinsfile text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sql       text eol=lf
