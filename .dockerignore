.github
.env
.env.*
!.env.example
**/__pycache__
**/*.pyc
.venv
venv
.pytest_cache
.ruff_cache
.coverage
htmlcov
reports
*.db
docs
k8s
jenkins
monitoring
scripts
tests/load
docker-compose*.yml
Makefile
*.md
